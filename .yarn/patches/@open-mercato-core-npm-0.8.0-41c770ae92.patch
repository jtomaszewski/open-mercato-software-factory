@@ -0,0 +1,19 @@
+import { afterCommandCommit, type CommandRuntimeContext } from '@open-mercato/shared/lib/commands'
+import { emitCrudSideEffects, emitCrudUndoSideEffects } from '@open-mercato/shared/lib/commands/helpers'
+
+export async function emitStaffTaskSideEffects<TEntity extends object>(
+  ctx: CommandRuntimeContext,
+  options: Parameters<typeof emitCrudSideEffects<TEntity>>[0],
+): Promise<void> {
+  const snapshot = { ...options, entity: { ...options.entity }, identifiers: { ...options.identifiers } }
+  await afterCommandCommit(ctx, () => emitCrudSideEffects(snapshot))
+}
+
+export async function emitStaffTaskUndoSideEffects<TEntity extends object>(
+  ctx: CommandRuntimeContext,
+  options: Parameters<typeof emitCrudUndoSideEffects<TEntity>>[0],
+): Promise<void> {
+  if (!options.entity) return
+  const snapshot = { ...options, entity: { ...options.entity }, identifiers: { ...options.identifiers } }
+  await afterCommandCommit(ctx, () => emitCrudUndoSideEffects(snapshot))
+}
