@@ -0,0 +1,116 @@
+import { LockMode } from '@mikro-orm/core'
+import type { EntityManager } from '@mikro-orm/postgresql'
+import { isManagedCommandTransaction, type CommandRuntimeContext } from '@open-mercato/shared/lib/commands'
+import { resolveTranslations } from '@open-mercato/shared/lib/i18n/server'
+import { CrudHttpError } from '@open-mercato/shared/lib/crud/errors'
+import { findOneWithDecryption, findWithDecryption } from '@open-mercato/shared/lib/encryption/find'
+import { StaffTeamMember, StaffTimeProject, StaffTimeTask, StaffTimeTaskStatus } from '../data/entities'
+import { applyScopeToWhere, commandActorScope, ensureOrganizationScope, ensureTenantScope, scopeForDecryption } from '../commands/shared'
+
+export type StaffTimeTaskMutationSnapshot = Readonly<{
+  taskId: string
+  timeProjectId: string
+  tenantId: string
+  organizationId: string
+  parentTaskId: string | null
+  reference: string
+  title: string
+  updatedAt: string
+  taskStatusId: string
+  statusSlug: string
+  isDone: boolean
+  assigneeStaffMemberId: string | null
+  assigneeUserId: string | null
+  childTaskIds: readonly string[]
+}>
+
+export type StaffTimeTaskMutationService = {
+  lockProject(ctx: CommandRuntimeContext, input: { timeProjectId: string }): Promise<void>
+  lockTask(ctx: CommandRuntimeContext, input: { taskId: string; includeChildren?: boolean; includeDeleted?: boolean }): Promise<StaffTimeTaskMutationSnapshot>
+}
+
+const projectLocks = new WeakMap<EntityManager, string>()
+
+async function notFound(): Promise<CrudHttpError> {
+  const { translate } = await resolveTranslations()
+  return new CrudHttpError(404, { error: translate('staff.errors.notFound', 'Not found') })
+}
+
+
+function transactionEm(ctx: CommandRuntimeContext): EntityManager {
+  const em = ctx.transactionalEm
+  if (!isManagedCommandTransaction(ctx) || !em?.isInTransaction()) throw new Error('[internal] Staff task mutation requires a managed command transaction')
+  return em
+}
+
+export async function lockStaffTaskProject(ctx: CommandRuntimeContext, timeProjectId: string): Promise<void> {
+  const em = transactionEm(ctx)
+  const previousProject = projectLocks.get(em)
+  if (previousProject && previousProject !== timeProjectId) {
+    throw new Error('[internal] A staff task transaction must stay within one project')
+  }
+  const scope = commandActorScope(ctx)
+  const project = await findOneWithDecryption(em, StaffTimeProject,
+    applyScopeToWhere<StaffTimeProject>({ id: timeProjectId, deletedAt: null }, scope),
+    { lockMode: LockMode.PESSIMISTIC_WRITE, refresh: true }, scopeForDecryption(scope))
+  if (!project) throw await notFound()
+  ensureTenantScope(ctx, project.tenantId)
+  ensureOrganizationScope(ctx, project.organizationId)
+  projectLocks.set(em, timeProjectId)
+}
+
+async function lockTask(
