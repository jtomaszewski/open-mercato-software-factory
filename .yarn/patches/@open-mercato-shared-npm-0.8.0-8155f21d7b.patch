index 0000000000000000000000000000000000000000..8201ec9332d4fccb4c1c44ead917414b426ac3bf
--- /dev/null
+++ b/src/lib/commands/transaction.ts
@@ -0,0 +1,138 @@
+import type { EntityManager } from '@mikro-orm/postgresql'
+import type { CommandRuntimeContext } from './types'
+
+type CommandCommitEffect = () => void | Promise<void>
+
+type CommandTransactionLifecycle = {
+  effects: CommandCommitEffect[]
+  em: EntityManager
+  rollbackCause: unknown
+  rollbackOnly: boolean
+  state: 'active' | 'committed' | 'rolled_back'
+}
+
+const managedTransactions = new WeakMap<CommandRuntimeContext, CommandTransactionLifecycle>()
+
+export class CommandTransactionRollbackError extends Error {
+  readonly cause: unknown
+
+  constructor(cause: unknown) {
+    super('Command transaction rolled back because a nested operation failed')
+    this.name = 'CommandTransactionRollbackError'
+    this.cause = cause
+  }
+}
+
+export class CommandPostCommitError extends Error {
+  readonly cause: unknown
+
+  constructor(cause: unknown) {
+    super('Command transaction committed, but a post-commit effect failed')
+    this.name = 'CommandPostCommitError'
+    this.cause = cause
+  }
+}
+
+export function isManagedCommandTransaction(ctx: CommandRuntimeContext): boolean {
+  return managedTransactions.get(ctx)?.state === 'active'
+}
+
+export async function afterCommandCommit(
+  ctx: CommandRuntimeContext,
+  effect: CommandCommitEffect,
+): Promise<void> {
+  const lifecycle = managedTransactions.get(ctx)
+  if (!lifecycle && ctx.transactionalEm) {
+    throw new Error('[internal] Managed command transaction required for deferred effects')
+  }
+  if (!lifecycle || lifecycle.state === 'committed') {
+    await effect()
+    return
+  }
+  if (lifecycle.state === 'rolled_back') return
+  lifecycle.effects.push(effect)
+}
+
+export async function runInCommandTransaction<TResult>(
+  ctx: CommandRuntimeContext,
+  work: (managedCtx: CommandRuntimeContext) => TResult | Promise<TResult>,
+): Promise<TResult> {
+  const existing = managedTransactions.get(ctx)
+  if (existing) {
+    if (existing.state !== 'active') {
+      throw new Error('Managed command transaction required; transaction context is no longer active')
+    }
+    try {
+      return await work(ctx)
+    } catch (error) {
+      existing.rollbackOnly = true
+      existing.rollbackCause ??= error
+      throw error
+    }
+  }
+
+  if (ctx.transactionalEm) {
+    throw new Error('Managed command transaction required; caller-owned transactionalEm is not accepted')
+  }
+
+  const rootEm = ctx.container.resolve('em') as EntityManager
+  const fork = rootEm.fork()
+  const state: {
+    lifecycle?: CommandTransactionLifecycle
+    managedCtx?: CommandRuntimeContext
+  } = {}
+
+  let result!: TResult
+  try {
+    result = await fork.transactional(async (em) => {
+      const lifecycle: CommandTransactionLifecycle = {
+        effects: [],
+        em,
+        rollbackCause: undefined,
+        rollbackOnly: false,
+        state: 'active',
+      }
+      const managedCtx = { ...ctx, transactionalEm: em }
+      state.lifecycle = lifecycle
+      state.managedCtx = managedCtx
+      managedTransactions.set(managedCtx, lifecycle)
+
+      try {
+        const value = await work(managedCtx)
+        if (lifecycle.rollbackOnly) {
+          throw new CommandTransactionRollbackError(lifecycle.rollbackCause)
+        }
+        return value
+      } catch (error) {
+        lifecycle.rollbackOnly = true
+        lifecycle.rollbackCause ??= error
+        lifecycle.state = 'rolled_back'
+        lifecycle.effects.length = 0
+        throw error
+      }
+    })
+  } catch (error) {
+    const lifecycle = state.lifecycle
+    const managedCtx = state.managedCtx
+    if (lifecycle) {
+      lifecycle.state = 'rolled_back'
+      lifecycle.effects.length = 0
+    }
+    if (managedCtx) managedTransactions.delete(managedCtx)
+    throw error
+  }
+
+  const lifecycle = state.lifecycle
+  const managedCtx = state.managedCtx
+  if (!lifecycle || !managedCtx) return result
+  lifecycle.state = 'committed'
+  try {
+    for (const effect of lifecycle.effects) await effect()
+  } catch (error) {
+    throw new CommandPostCommitError(error)
+  } finally {
+    managedTransactions.delete(managedCtx)
+  }
+
+  return result
+}
