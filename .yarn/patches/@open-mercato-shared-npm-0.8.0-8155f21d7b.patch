+  "sourcesContent": ["import type { EntityManager } from '@mikro-orm/postgresql'\nimport type { CommandRuntimeContext } from './types'\n\ntype CommandCommitEffect = () => void | Promise<void>\n\ntype CommandTransactionLifecycle = {\n  effects: CommandCommitEffect[]\n  em: EntityManager\n  rollbackCause: unknown\n  rollbackOnly: boolean\n  state: 'active' | 'committed' | 'rolled_back'\n}\n\nconst managedTransactions = new WeakMap<CommandRuntimeContext, CommandTransactionLifecycle>()\n\nexport class CommandTransactionRollbackError extends Error {\n  readonly cause: unknown\n\n  constructor(cause: unknown) {\n    super('Command transaction rolled back because a nested operation failed')\n    this.name = 'CommandTransactionRollbackError'\n    this.cause = cause\n  }\n}\n\nexport class CommandPostCommitError extends Error {\n  readonly cause: unknown\n\n  constructor(cause: unknown) {\n    super('Command transaction committed, but a post-commit effect failed')\n    this.name = 'CommandPostCommitError'\n    this.cause = cause\n  }\n}\n\nexport function isManagedCommandTransaction(ctx: CommandRuntimeContext): boolean {\n  return managedTransactions.get(ctx)?.state === 'active'\n}\n\nexport async function afterCommandCommit(\n  ctx: CommandRuntimeContext,\n  effect: CommandCommitEffect,\n): Promise<void> {\n  const lifecycle = managedTransactions.get(ctx)\n  if (!lifecycle && ctx.transactionalEm) {\n    throw new Error('[internal] Managed command transaction required for deferred effects')\n  }\n  if (!lifecycle || lifecycle.state === 'committed') {\n    await effect()\n    return\n  }\n  if (lifecycle.state === 'rolled_back') return\n  lifecycle.effects.push(effect)\n}\n\nexport async function runInCommandTransaction<TResult>(\n  ctx: CommandRuntimeContext,\n  work: (managedCtx: CommandRuntimeContext) => TResult | Promise<TResult>,\n): Promise<TResult> {\n  const existing = managedTransactions.get(ctx)\n  if (existing) {\n    if (existing.state !== 'active') {\n      thro